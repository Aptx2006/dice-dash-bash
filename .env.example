# 仅由Node服务读取；不要使用VITE_前缀，也不要提交真实密钥。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
# 可使用环境变量DASHSCOPE_API_KEY，或在本地.env中填写以下项。
LLM_API_KEY=
COACH_PORT=3001
# 受控部署可显式允许完整网页origin，逗号分隔；默认只允许回环地址。
# 局域网开发建议使用 npm run dev:all -- --lan 自动设置当前私有IP来源。
GAME_ALLOWED_ORIGINS=
# 服务端房间数据库，可留空使用项目data/rooms.sqlite；应放在私有目录。
GAME_ROOM_DB=
